# macOS
.DS_Store

# build output
dist/

# generated types
.astro/

# dependencies (no trailing slash: a worktree may link node_modules instead of copying it)
node_modules

# local SQLite database (regenerated from db/games.csv)
*.db

# catalog export written by `npm run db:export` (the Concierge builds it in memory instead)
db/catalog.json

# environment variables
.env
.env.production

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# editors
.idea/
*.swp

# worktrees created by `claude -w`
.claude/worktrees/
