---
import type { CatalogFilters } from '../lib/catalog-filters';
import CategoryFilter from './CategoryFilter.astro';

interface Props {
    /** The filters kept from the URL, shown as the current state of each control. */
    filters: CatalogFilters;
}

const { filters } = Astro.props;

const focusRing =
    'focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-800';
---

<form
    method="get"
    action="/"
    class="mb-4 p-6 bg-slate-800/60 rounded-xl border border-slate-700/50 flex flex-col gap-6"
    data-testid="catalog-filters"
>
    <CategoryFilter selectedIds={filters.categoryIds} />

    <div class="flex flex-wrap items-center gap-4">
        <button
            type="submit"
            class:list={['px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition-colors', focusRing]}
            data-testid="apply-filters"
        >
            Apply filters
        </button>
        <a
            href="/"
            class:list={['px-2 py-1 rounded text-sm text-blue-400 hover:text-blue-300 hover:underline', focusRing]}
            data-testid="clear-filters"
        >
            Clear filters
        </a>
    </div>
</form>
