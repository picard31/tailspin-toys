---
import { getDatabase } from '../lib/db';
import { getAllCategories } from '../lib/category-filter';

interface Props {
    /** The category ids kept from the URL, whose options are checked. */
    selectedIds: number[];
}

const { selectedIds } = Astro.props;
const categories = await getAllCategories(getDatabase());

const optionClasses = 'inline-flex items-center gap-2 text-slate-300 cursor-pointer';
const radioClasses =
    'h-4 w-4 accent-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-800';
---

<fieldset data-testid="category-filter">
    <legend class="text-sm font-medium text-slate-100 mb-3">Category</legend>
    <div class="flex flex-wrap gap-x-6 gap-y-3">
        <label class={optionClasses}>
            <input
                type="radio"
                name="category"
                value=""
                checked={selectedIds.length === 0}
                class={radioClasses}
                data-testid="category-option"
            />
            All categories
        </label>
        {categories.map((category) => (
            <label class={optionClasses}>
                <input
                    type="radio"
                    name="category"
                    value={category.id}
                    checked={selectedIds.includes(category.id)}
                    class={radioClasses}
                    data-testid="category-option"
                />
                {category.name}
            </label>
        ))}
    </div>
</fieldset>
