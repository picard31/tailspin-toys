---
import type { CatalogSort } from '../lib/catalog-sort';

interface Props {
    /** The sort kept from the URL, whose options are selected. */
    sort: CatalogSort;
}

const { sort } = Astro.props;

const labelClasses = 'text-sm font-medium text-slate-100';
const selectClasses =
    'px-3 py-2 rounded-lg bg-slate-900 border border-slate-600 text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-800';
---

<div class="flex flex-wrap gap-x-6 gap-y-3">
    <div class="flex flex-col gap-2">
        <label for="sort-property" class={labelClasses}>Sort by</label>
        <select id="sort-property" name="sortProperty" class={selectClasses} data-testid="sort-property">
            <option value="title" selected={sort.property === 'title'}>Title</option>
            <option value="rating" selected={sort.property === 'rating'}>Rating</option>
        </select>
    </div>
    <div class="flex flex-col gap-2">
        <label for="sort-direction" class={labelClasses}>Order</label>
        <select id="sort-direction" name="sortDirection" class={selectClasses} data-testid="sort-direction">
            <option value="asc" selected={sort.direction === 'asc'}>Ascending</option>
            <option value="desc" selected={sort.direction === 'desc'}>Descending</option>
        </select>
    </div>
</div>
