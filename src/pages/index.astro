---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import CatalogFilters from '../components/CatalogFilters.astro';
import { getDatabase } from '../lib/db';
import { getCatalog } from '../lib/games';
import { hasActiveFilters } from '../lib/catalog-filters';

// Rendered on demand: the filters and the search are read from the query string (ADR 0001).
export const prerender = false;

const { games, total, filters, search, clearSearchHref, clearFiltersHref } = await getCatalog(getDatabase(), Astro.url.searchParams);
const filtered = hasActiveFilters(filters);

// The search wins over the filters: it is what the visitor typed, so it says best why the list is short.
const title = search !== null
    ? `Search results for "${search}" - Tailspin Toys`
    : filtered
        ? 'Filtered games - Tailspin Toys'
        : 'Tailspin Toys - Crowdfunding your new favorite game!';

const noMatchMessage = search === null
    ? 'No games match these filters.'
    : filtered
        ? `No games match "${search}" with these filters.`
        : `No games match "${search}".`;

const clearLinkClass = 'px-2 py-1 rounded text-sm text-blue-400 hover:text-blue-300 hover:underline focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-800';
---

<Layout title={title}>
    <div class="py-8">
        <PageHero
            title="Welcome to Tailspin Toys"
            subtitle="Find your next game! And maybe even back one! Explore our collection!"
        />

        <div>
            <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

            <CatalogFilters filters={filters} search={search} clearSearchHref={clearSearchHref} clearFiltersHref={clearFiltersHref} />

            <p class="mb-6 text-sm text-slate-400" data-testid="results-count">
                Showing {games.length} of {total} games
            </p>

            {total === 0 ? (
                <EmptyState text="No games available at the moment." />
            ) : games.length === 0 ? (
                <EmptyState>
                    <p data-testid="no-matching-games" class="text-slate-300">{noMatchMessage}</p>
                    {/* Only the links that change something. One at least shows: only a search or a filter empties a non-empty catalog. */}
                    <div class="mt-3 flex flex-wrap justify-center gap-4">
                        {search !== null && (
                            <a href={clearSearchHref} class={clearLinkClass} data-testid="no-matching-games-clear-search">
                                Clear search
                            </a>
                        )}
                        {filtered && (
                            <a href={clearFiltersHref} class={clearLinkClass} data-testid="no-matching-games-clear-filters">
                                Clear filters
                            </a>
                        )}
                    </div>
                </EmptyState>
            ) : (
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
                    {games.map((game) => <GameCard game={game} />)}
                </div>
            )}
        </div>
    </div>
</Layout>
