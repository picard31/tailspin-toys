---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

export const prerender = true;

const focusRing = 'focus:outline-none focus:ring-2 focus:ring-blue-500';
---

<Layout title="Backer Concierge - Tailspin Toys">
  <div class="py-8 max-w-3xl">
    <PageHero
      title="Backer Concierge"
      subtitle="Ask a question about our games. The Concierge only knows the Tailspin Toys catalog."
    />

    <noscript>
      <p class="mb-6 p-4 rounded-xl bg-slate-800 border border-slate-700 text-slate-300">
        The Backer Concierge needs JavaScript. Please enable it to ask a question.
      </p>
    </noscript>

    <div
      role="log"
      aria-label="Conversation with the Backer Concierge"
      class="space-y-4 mb-4"
      data-testid="concierge-log"
    ></div>

    <p
      role="status"
      aria-live="polite"
      class="min-h-6 mb-4 text-sm text-slate-400"
      data-testid="concierge-status"
    ></p>

    <form
      class="p-6 bg-slate-800/60 rounded-xl border border-slate-700/50"
      data-testid="concierge-form"
    >
      <label for="concierge-question" class="block mb-2 text-sm font-medium text-slate-100">Your question</label>
      <div class="flex flex-col sm:flex-row gap-3">
        <input
          id="concierge-question"
          name="question"
          type="text"
          maxlength="500"
          autocomplete="off"
          class:list={['flex-1 px-4 py-2 rounded-lg bg-slate-900 border border-slate-700 text-slate-100 placeholder-slate-500', focusRing]}
          data-testid="concierge-question"
        />
        <button
          type="submit"
          class:list={['px-6 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors', focusRing]}
          data-testid="concierge-ask"
        >
          Ask
        </button>
      </div>
    </form>
  </div>
</Layout>

<script>
  interface ConciergeReply {
    answer?: unknown;
    error?: unknown;
  }

  const UNREACHABLE = 'The Backer Concierge could not be reached. Please try again.';

  const form = document.querySelector<HTMLFormElement>('[data-testid="concierge-form"]');
  const field = document.querySelector<HTMLInputElement>('[data-testid="concierge-question"]');
  const ask = document.querySelector<HTMLButtonElement>('[data-testid="concierge-ask"]');
  const log = document.querySelector<HTMLElement>('[data-testid="concierge-log"]');
  const status = document.querySelector<HTMLElement>('[data-testid="concierge-status"]');

  /** A labelled block of plain text: text is never interpreted as HTML. */
  function entry(label: string, text: string, classes: string, testId?: string): HTMLElement {
    const block = document.createElement('div');
    block.className = `p-4 rounded-xl border ${classes}`;
    const heading = document.createElement('p');
    heading.className = 'text-xs font-medium uppercase tracking-wide text-slate-400 mb-1';
    heading.textContent = label;
    const body = document.createElement('p');
    body.className = 'whitespace-pre-line text-slate-100';
    body.textContent = text;
    if (testId) {
      body.dataset.testid = testId;
    }
    block.append(heading, body);
    return block;
  }

  /** Send the question to the route; a network failure reads as an error reply. */
  async function askConcierge(question: string): Promise<{ ok: boolean; reply: ConciergeReply }> {
    try {
      const response = await fetch('/api/concierge', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: [{ role: 'user', content: question }] }),
      });
      return { ok: response.ok, reply: (await response.json()) as ConciergeReply };
    } catch {
      return { ok: false, reply: { error: UNREACHABLE } };
    }
  }

  if (form && field && ask && log && status) {
    let pending = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      // One question at a time: the button does not send a second one while waiting.
      if (pending) {
        return;
      }
      pending = true;
      ask.setAttribute('aria-disabled', 'true');
      status.textContent = 'Thinking…';

      const question = field.value;
      log.append(entry('You', question, 'bg-slate-800 border-slate-700'));
      const { ok, reply } = await askConcierge(question);

      if (ok && typeof reply.answer === 'string') {
        log.append(entry('Backer Concierge', reply.answer, 'bg-blue-950/40 border-blue-900', 'concierge-answer'));
        field.value = '';
      } else {
        const message = typeof reply.error === 'string' ? reply.error : UNREACHABLE;
        log.append(entry('Backer Concierge', message, 'bg-red-950/40 border-red-900', 'concierge-error'));
      }

      status.textContent = '';
      ask.removeAttribute('aria-disabled');
      pending = false;
      field.focus();
    });
  }
</script>
